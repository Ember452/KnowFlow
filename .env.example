# KnowFlow 环境变量模板
# 复制为 .env 并填入真实值；P1 阶段会补全全部配置项与注释。

# ── 应用 ──
KNOWFLOW_APP_NAME=KnowFlow
KNOWFLOW_ENV=dev
KNOWFLOW_DEBUG=true
KNOWFLOW_LOG_LEVEL=INFO
KNOWFLOW_API_PREFIX=/api/v1

# ── PostgreSQL ──
KNOWFLOW_POSTGRES_HOST=localhost
KNOWFLOW_POSTGRES_PORT=5432
KNOWFLOW_POSTGRES_USER=knowflow
KNOWFLOW_POSTGRES_PASSWORD=nexus
KNOWFLOW_POSTGRES_DB=knowflow

# ── Redis ──
KNOWFLOW_REDIS_URL=redis://localhost:6379/0

# ── Milvus ──
KNOWFLOW_MILVUS_URI=http://localhost:19530

# ── MinIO ──
KNOWFLOW_MINIO_ENDPOINT=localhost:9000
KNOWFLOW_MINIO_ACCESS_KEY=minioadmin
KNOWFLOW_MINIO_SECRET_KEY=minioadmin
KNOWFLOW_MINIO_BUCKET=knowflow
KNOWFLOW_MINIO_SECURE=false

# ── LLM ──
KNOWFLOW_LLM_API_KEY=sk-xxx
KNOWFLOW_LLM_BASE_URL=https://api.deepseek.com/v1
KNOWFLOW_LLM_MODEL=deepseek-chat
KNOWFLOW_EMBEDDING_MODEL=BAAI/bge-m3
KNOWFLOW_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ── 检索 ──
KNOWFLOW_CHUNK_SIZE=512
KNOWFLOW_CHUNK_OVERLAP=64
KNOWFLOW_RETRIEVAL_TOP_K=10
KNOWFLOW_RRF_K=60
KNOWFLOW_RETRIEVAL_CACHE_TTL_SECONDS=300
KNOWFLOW_EMBEDDING_BATCH_SIZE=32
KNOWFLOW_RERANKER_TOP_K=10

# ── 上下文 ──
KNOWFLOW_CONTEXT_BUDGET_TOKENS=32000
KNOWFLOW_SPILL_THRESHOLD_TOKENS=4000
KNOWFLOW_WINDOW_MAX_TURNS=20

# ── 存储 ──
KNOWFLOW_SESSION_TTL_SECONDS=3600
KNOWFLOW_WORKSPACE_QUOTA_BYTES=104857600

# ── API 与上传 ──
KNOWFLOW_CORS_ORIGINS=*
KNOWFLOW_RATE_LIMIT_PER_MINUTE=60
KNOWFLOW_UPLOAD_MAX_BYTES=52428800
KNOWFLOW_UPLOAD_ALLOWED_TYPES=pdf,docx,md,txt

# ── 任务队列（Redis Stream）──
KNOWFLOW_TASK_STREAM_INDEX=knowflow:tasks:index
KNOWFLOW_TASK_STREAM_DLQ=knowflow:tasks:dlq
KNOWFLOW_TASK_CONSUMER_GROUP=knowflow-indexer
KNOWFLOW_TASK_CONSUMER_NAME=worker-1
KNOWFLOW_TASK_MAX_RETRIES=3
KNOWFLOW_TASK_BLOCK_MS=5000
