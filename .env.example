# KnowFlow 环境变量模板
# 复制为 .env 并填入真实值。

# ── 应用 ──
KNOWFLOW_APP_NAME=KnowFlow
KNOWFLOW_ENV=dev
KNOWFLOW_DEBUG=true
KNOWFLOW_LOG_LEVEL=INFO
KNOWFLOW_API_PREFIX=/api/v1

# ── PostgreSQL ──
KNOWFLOW_POSTGRES_HOST=localhost
KNOWFLOW_POSTGRES_PORT=5432
KNOWFLOW_POSTGRES_USER=knowflow
KNOWFLOW_POSTGRES_PASSWORD=nexus
KNOWFLOW_POSTGRES_DB=knowflow

# ── Redis ──
KNOWFLOW_REDIS_URL=redis://localhost:6379/0

# ── Milvus ──
KNOWFLOW_MILVUS_URI=http://localhost:19530

# ── MinIO ──
KNOWFLOW_MINIO_ENDPOINT=localhost:9000
KNOWFLOW_MINIO_ACCESS_KEY=minioadmin
KNOWFLOW_MINIO_SECRET_KEY=minioadmin
KNOWFLOW_MINIO_BUCKET=knowflow
KNOWFLOW_MINIO_SECURE=false

# ── LLM（OpenAI 兼容接口，默认 DeepSeek 官方）──
KNOWFLOW_LLM_API_KEY=sk-xxx
KNOWFLOW_LLM_BASE_URL=https://api.deepseek.com/v1
KNOWFLOW_LLM_MODEL=deepseek-v4-flash

# ── Embedding（api=阿里云百炼 / local=本地 sentence-transformers）──
# qwen3.7-text-embedding 走 OpenAI 兼容接口，默认输出 1024 维（与 Milvus dim 一致）
KNOWFLOW_EMBEDDING_PROVIDER=api
KNOWFLOW_EMBEDDING_MODEL=qwen3.7-text-embedding
KNOWFLOW_EMBEDDING_API_KEY=sk-xxx（阿里云百炼 Key）
KNOWFLOW_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── Reranker（api=阿里云百炼 / local=本地 cross-encoder）──
# 百炼现役精排模型 qwen3-rerank（gte-rerank/gte-rerank-v2 已下架），走 DashScope 原生 API
KNOWFLOW_RERANKER_PROVIDER=api
KNOWFLOW_RERANKER_MODEL=qwen3-rerank
KNOWFLOW_RERANKER_API_KEY=sk-xxx（阿里云百炼 Key）
KNOWFLOW_RERANKER_API_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# ── 检索 ──
KNOWFLOW_CHUNK_SIZE=512
KNOWFLOW_CHUNK_OVERLAP=64
KNOWFLOW_RETRIEVAL_TOP_K=10
KNOWFLOW_RRF_K=60
KNOWFLOW_RETRIEVAL_CACHE_TTL_SECONDS=300
KNOWFLOW_EMBEDDING_BATCH_SIZE=32
KNOWFLOW_RERANKER_TOP_K=10

# ── 上下文 ──
KNOWFLOW_CONTEXT_BUDGET_TOKENS=32000
KNOWFLOW_SPILL_THRESHOLD_TOKENS=4000
KNOWFLOW_WINDOW_MAX_TURNS=20

# ── 存储 ──
KNOWFLOW_SESSION_TTL_SECONDS=3600
KNOWFLOW_WORKSPACE_QUOTA_BYTES=104857600

# ── API 与上传 ──
KNOWFLOW_CORS_ORIGINS=*
KNOWFLOW_RATE_LIMIT_PER_MINUTE=60
KNOWFLOW_UPLOAD_MAX_BYTES=52428800
KNOWFLOW_UPLOAD_ALLOWED_TYPES=pdf,docx,md,txt

# ── 任务队列（Redis Stream）──
KNOWFLOW_TASK_STREAM_INDEX=knowflow:tasks:index
KNOWFLOW_TASK_STREAM_DLQ=knowflow:tasks:dlq
KNOWFLOW_TASK_CONSUMER_GROUP=knowflow-indexer
KNOWFLOW_TASK_CONSUMER_NAME=worker-1
KNOWFLOW_TASK_MAX_RETRIES=3
KNOWFLOW_TASK_BLOCK_MS=5000

# ── Multi-Agent 编排 ──
KNOWFLOW_AGENT_TIMEOUT_SECONDS=60   # 子 Agent 执行超时(秒)
KNOWFLOW_AGENT_MAX_SUBTASKS=5      # 主 Agent 最大委派子任务数

# ── MCP 工具接入（JSON 数组，每项声明一个 stdio MCP Server）──
# 启动时自动连接 Server 并拉取工具清单，注册进统一工具注册表，自动纳入执行域隔离；
# 单个 Server 不可用仅告警降级、不阻塞启动；修改配置后需重启生效。
# 字段: id 逻辑名(工具前缀 mcp_<id>_*) / command 启动命令 / args 启动参数 /
#       domain 执行域(direct|skill_only|subagent_only) / env 附加环境变量 / allow_tools 工具白名单(只注册白名单内工具)
# 默认不启用(留空注释); 需要时取消注释并按需修改, 例如内置 demo Server:
# KNOWFLOW_MCP_SERVERS=[{"id": "demo", "command": "python", "args": ["-m", "knowflow.tools.mcp.servers.demo"], "domain": "skill_only"}]
# 例如飞书官方 lark-openapi-mcp(推荐, 需 Node 环境; allow_tools 按官方 list_tools 实测工具名配置):
# KNOWFLOW_MCP_SERVERS=[{"id": "feishu", "command": "npx", "args": ["-y", "lark-openapi-mcp"], "domain": "skill_only", "env": {"APP_ID": "cli_xxx", "APP_SECRET": "xxx", "USER_ACCESS_TOKEN": "u-xxx"}, "allow_tools": ["create_doc"]}]
# 例如飞书自建兜底 server(无 Node 环境时, 工具名固定 create_doc/append_to_doc/update_doc):
# KNOWFLOW_MCP_SERVERS=[{"id": "feishu", "command": "python", "args": ["-m", "knowflow.tools.mcp.servers.feishu.server"], "domain": "skill_only", "env": {"APP_ID": "cli_xxx", "APP_SECRET": "xxx", "USER_ACCESS_TOKEN": "u-xxx"}}]

# ── 飞书发布（V2 报告平台，需飞书开放平台自建应用 + 云文档读写权限 + 用户授权）──
KNOWFLOW_FEISHU_APP_ID=
KNOWFLOW_FEISHU_APP_SECRET=
KNOWFLOW_FEISHU_USER_ACCESS_TOKEN=
KNOWFLOW_MCP_CALL_TIMEOUT_SECONDS=30   # MCP 工具单次调用超时(秒), 防远端 server 挂死
